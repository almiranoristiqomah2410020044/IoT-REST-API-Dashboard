  {
    "id": "fn_post_kontrol_001",
    "type": "function",
    "z": "flow_rest_api_001",
    "name": "Validasi & Kirim Kontrol",
    "func": "var body = msg.payload || {};\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.headers = {'Content-Type':'application/json','Access-Control-Allow-Origin':'*'};\n    msg.payload = {status:'error', message:'device dan action wajib diisi'};\n    return [msg, null];\n}\nvar responseMsg = RED.util.cloneMessage(msg);\nresponseMsg.statusCode = 200;\nresponseMsg.headers = {'Content-Type':'application/json','Access-Control-Allow-Origin':'*'};\nresponseMsg.payload = {status:'success', message:'Perintah diterima Node-RED', sent:body};\nvar mqttMsg = {topic:'iot/kontrol', payload:body};\nreturn [responseMsg, mqttMsg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 400,
    "wires": [
      [
        "http_resp_kontrol_001"
      ],
