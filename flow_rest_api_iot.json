  {
    "id": "fn_store_sensor_001",
    "type": "function",
    "z": "flow_rest_api_001",
    "name": "Simpan Data Sensor",
    "func": "var data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) { node.error('Payload MQTT bukan JSON valid', msg); return null; }\n}\nif (!data || typeof data !== 'object') return null;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\nmsg.payload = data;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 100,
    "wires": [
      [
        "debug_sensor_001"
      ]
    ]
  },
